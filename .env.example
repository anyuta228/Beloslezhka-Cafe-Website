# ==============================================================================
# Кафе «Белоснежка» — Пример конфигурации (.env.example)
# Скопируйте этот файл в .env и укажите ваши реальные параметры
# ==============================================================================

# Подключение к базе данных MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=belka_db
DB_USER=belka_user
DB_PASS=your_strong_database_password_here

# Сервисный ключ доступа и ID получателя ВКонтакте
VK_ACCESS_TOKEN=your_vk_access_token_here
VK_USER_ID=your_vk_user_id_here

# Окружение
APP_ENV=production

# Разрешённые источники для CORS
ALLOWED_ORIGINS=https://belka-cafe.ru,http://belka-cafe.ru,http://localhost:3000
